# Apenas servidor. Nunca prefixar com VITE_.
GEMINI_API_KEY=
# Modelo configurável, sem depender de um modelo fixo no navegador.
GEMINI_MODEL=gemini-2.5-flash
# Reservas usadas em ordem quando o modelo principal responde com limite ou sobrecarga.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
